<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        Joyn VOD/Live player controller:
        - no large centre transport controls;
        - seek is primarily DPAD left/right, double tap or the timeline;
        - only the essential controls remain along the bottom edge.
    -->
    <FrameLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:layoutDirection="ltr">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:layoutDirection="ltr">

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/ExoStyledControls.Button.Center.PlayPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:padding="9dp" />

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="/"
                android:textColor="#BFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration" />
        </LinearLayout>

        <LinearLayout
            android:id="@id/exo_basic_controls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp"
            android:layoutDirection="ltr">

            <ImageButton
                android:id="@id/exo_subtitle"
                style="@style/ExoStyledControls.Button.Bottom.CC"
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <ImageButton
                android:id="@id/exo_settings"
                style="@style/ExoStyledControls.Button.Bottom.Settings"
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="56dp"
        android:focusable="true"
        android:nextFocusDown="@id/exo_play_pause"
        app:bar_gravity="center"
        app:bar_height="3dp"
        app:touch_target_height="32dp"
        app:scrubber_enabled_size="12dp"
        app:scrubber_dragged_size="16dp"
        app:played_color="@android:color/white"
        app:scrubber_color="@android:color/white"
        app:buffered_color="#80FFFFFF"
        app:unplayed_color="#55FFFFFF" />

</merge>
